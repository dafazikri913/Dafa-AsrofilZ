---
import TechGrid from '@/components/ui/TechGrid.astro'

interface Props {
  bio: string[]
  skills?: string[]
}

const { bio } = Astro.props
---

<section id="about" class="py-12 md:py-14 px-4 max-w-3xl mx-auto border-t border-purple-500/10">
  <h2 class="reveal-init text-3xl font-bold text-white mb-8 text-center">About Me</h2>

  <div class="flex flex-col gap-10">
    {/* Bio paragraphs */}
    <div class="reveal-init flex flex-col gap-4">
      {bio.map((paragraph) => (
        <p class="text-white/70 text-base md:text-lg leading-relaxed">
          {paragraph}
        </p>
      ))}
    </div>

    {/* Technologies Grid */}
    <div class="reveal-init">
      <div class="flex items-center justify-between mb-4">
        <h3 class="text-xs uppercase tracking-widest text-purple-400 font-semibold">Technologies & Tools</h3>
        <span class="text-xs text-white/40">18 Stacks</span>
      </div>
      <TechGrid />
    </div>
  </div>
</section>
