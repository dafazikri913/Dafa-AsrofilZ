---
interface Props {
  bio: string[]
  skills: string[]
}

const { bio, skills } = Astro.props
---

<section id="about" class="py-12 md:py-14 px-4 max-w-3xl mx-auto border-t border-purple-500/10">
  <h2 class="reveal-init text-3xl font-bold text-white mb-8 text-center">About Me</h2>

  <div class="flex flex-col gap-8">
    {/* Bio paragraphs */}
    <div class="reveal-init flex flex-col gap-4">
      {bio.map((paragraph) => (
        <p class="text-white/70 text-base md:text-lg leading-relaxed">
          {paragraph}
        </p>
      ))}
    </div>

    {/* Skills */}
    <div class="reveal-init">
      <h3 class="text-sm uppercase tracking-widest text-white/40 mb-4">Technologies</h3>
      <div class="flex flex-wrap gap-2">
        {skills.map((skill) => (
          <span class="px-3 py-1 rounded-full text-sm bg-white/10 border border-white/15 text-white/80 hover:bg-white/20 hover:border-purple-500/40 transition-colors">
            {skill}
          </span>
        ))}
      </div>
    </div>
  </div>
</section>
