---
import { ArrowRight, Mail } from 'lucide-react'

interface Props {
  name: string
  expertise?: string
  roles?: string[]
  tagline: string
  avatarSrc: string
}

const { name, expertise, roles, tagline, avatarSrc } = Astro.props

const expertiseText = expertise || (roles && roles.length > 0 ? roles.join(' • ') : 'Frontend Developer & UI/UX Specialist')

const initials = name
  .split(' ')
  .map((n) => n[0])
  .join('')
  .toUpperCase()
  .slice(0, 2)
---

<section id="hero" class="py-12 md:py-16 px-4 max-w-4xl mx-auto flex items-center min-h-[75vh]">
  <div class="w-full flex flex-col-reverse md:flex-row items-center justify-center gap-6 md:gap-8">
    {/* Left Column: Text & CTAs */}
    <div class="flex-1 flex flex-col items-center md:items-start text-center md:text-left gap-4">
      
      {/* Status Pill Badge with Luminous Glowing White Beacon */}
      <div class="reveal-init">
        <span class="inline-flex items-center gap-2.5 px-3.5 py-1.5 rounded-full bg-white/[0.06] border border-white/20 text-white text-xs md:text-sm font-medium shadow-sm backdrop-blur-sm">
          {/* Luminous Glowing White Ball / Light Beacon */}
          <span class="relative flex h-2.5 w-2.5 items-center justify-center">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-white opacity-80"></span>
            <span class="relative inline-flex rounded-full h-2 w-2 bg-white shadow-[0_0_8px_2px_rgba(255,255,255,0.95),0_0_15px_4px_rgba(255,255,255,0.5)]"></span>
          </span>
          <span class="tracking-wide">Open for Projects</span>
        </span>
      </div>

      {/* Name Heading */}
      <h1 class="reveal-init text-4xl md:text-6xl font-extrabold text-white tracking-tight leading-tight">
        {name}
      </h1>

      {/* Expertise Sentence */}
      <div class="reveal-init text-lg md:text-xl font-semibold text-transparent bg-clip-text bg-gradient-to-r from-purple-300 via-indigo-200 to-purple-400">
        {expertiseText}
      </div>

      {/* Tagline */}
      <p class="reveal-init text-white/70 text-base md:text-lg max-w-lg leading-relaxed">
        {tagline}
      </p>

      {/* CTA Buttons */}
      <div class="reveal-init flex flex-wrap items-center justify-center md:justify-start gap-4 pt-1">
        <a
          href="#projects"
          class="group inline-flex items-center gap-2.5 px-7 py-3 rounded-full bg-purple-600 text-white font-medium text-sm md:text-base hover:bg-white hover:text-black transition-all duration-300 shadow-lg shadow-purple-900/40 cursor-pointer"
        >
          <span>Lihat Proyek</span>
          <ArrowRight className="w-4 h-4 text-white group-hover:text-black transition-colors duration-300" />
        </a>

        <a
          href="#contact"
          class="group inline-flex items-center gap-2.5 px-7 py-3 rounded-full bg-white/10 text-white/90 font-medium text-sm md:text-base hover:bg-white hover:text-black transition-all duration-300 shadow-lg shadow-black/20 cursor-pointer"
        >
          <Mail className="w-4 h-4 text-purple-300 group-hover:text-black transition-colors duration-300" />
          <span>Hubungi Saya</span>
        </a>
      </div>

      {/* Professional UX "Looking for Opportunities / Quick Connect" Micro-Form */}
      <div class="reveal-init w-full max-w-lg mt-2 p-3.5 sm:p-4 rounded-2xl bg-white/[0.03] border border-purple-500/25 hover:border-purple-500/40 transition-colors backdrop-blur-sm shadow-xl shadow-black/40 text-left">
        <div class="flex items-center justify-between gap-2 mb-2">
          <div class="flex items-center gap-2">
            <span class="relative flex h-2 w-2">
              <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
              <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-400 shadow-[0_0_8px_#34d399]"></span>
            </span>
            <span class="text-xs font-semibold text-white tracking-wide">Actively Seeking Opportunities</span>
          </div>
          <span class="text-[10px] sm:text-[11px] text-purple-300 bg-purple-950/70 border border-purple-500/30 px-2.5 py-0.5 rounded-full font-medium">
            Full-Time & Remote
          </span>
        </div>

        <p class="text-xs text-white/60 mb-3 leading-relaxed">
          Mencari Frontend Engineer atau UI/UX Specialist untuk tim Anda? Masukkan email Anda untuk mulai berdiskusi.
        </p>

        <form id="hero-quick-hire-form" class="flex flex-col sm:flex-row gap-2">
          <div class="relative flex-1">
            <input
              type="email"
              id="hero-inquiry-email"
              required
              placeholder="email-rekruter@perusahaan.com"
              class="w-full h-9 sm:h-10 px-3 rounded-xl bg-black/40 border border-white/15 text-xs sm:text-sm text-white placeholder:text-white/30 focus:outline-none focus:border-purple-400 focus:ring-1 focus:ring-purple-400 transition-all"
            />
          </div>
          <button
            type="submit"
            class="h-9 sm:h-10 px-4 rounded-xl bg-purple-600 hover:bg-white hover:text-black text-white text-xs sm:text-sm font-medium transition-all duration-300 flex items-center justify-center gap-1.5 shadow-md shadow-purple-900/40 cursor-pointer whitespace-nowrap"
          >
            <span>Ajak Diskusi</span>
            <ArrowRight className="w-3.5 h-3.5" />
          </button>
        </form>

        <div id="hero-form-feedback" class="hidden mt-2 text-xs text-emerald-400 items-center gap-1.5">
          <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
          <span>Pesan diskusi disiapkan! Membuka email ke Dafa...</span>
        </div>
      </div>

    </div>

    {/* Right Column: Photo on the Right */}
    <div class="reveal-init flex-shrink-0 relative group">
      {/* Ambient Glow behind avatar */}
      <div class="absolute -inset-2 bg-gradient-to-r from-purple-600 to-indigo-600 rounded-3xl blur-xl opacity-40 group-hover:opacity-70 transition duration-500 pointer-events-none"></div>

      {/* Photo frame */}
      <div class="relative w-44 h-44 sm:w-56 sm:h-56 md:w-64 md:h-64 rounded-3xl overflow-hidden border-2 border-purple-500/40 bg-purple-950/80 shadow-2xl shadow-purple-950/80 flex items-center justify-center">
        <img
          src={avatarSrc}
          alt={name}
          width="256"
          height="256"
          loading="eager"
          decoding="async"
          class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
          onerror="this.style.display='none'; this.nextElementSibling.classList.remove('hidden');"
        />
        <div
          class="hidden w-full h-full flex items-center justify-center text-4xl font-bold text-purple-200 bg-gradient-to-br from-purple-900 to-indigo-950"
          aria-label={`Avatar initials for ${name}`}
        >
          {initials}
        </div>
      </div>
    </div>
  </div>
</section>

<script is:inline>
  const hireForm = document.getElementById('hero-quick-hire-form');
  if (hireForm) {
    hireForm.addEventListener('submit', (e) => {
      e.preventDefault();
      const input = document.getElementById('hero-inquiry-email');
      const feedback = document.getElementById('hero-form-feedback');
      const emailVal = input ? input.value.trim() : '';
      if (!emailVal) return;

      const subject = encodeURIComponent('Peluang Kerja / Proyek Kolaborasi untuk Dafa Asrofil Z');
      const body = encodeURIComponent(
        `Halo Dafa,\n\nKami tertarik dengan profil portofolio Anda dan ingin mendiskusikan peluang kerja / kolaborasi posisi Frontend / UI/UX Specialist.\n\nEmail Kontak: ${emailVal}\n\nSalam,\n`
      );
      
      window.location.href = `mailto:hello@example.com?subject=${subject}&body=${body}`;

      if (feedback) {
        feedback.classList.remove('hidden');
        feedback.classList.add('flex');
      }
    });
  }
</script>
