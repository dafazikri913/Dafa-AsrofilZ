---
import { Briefcase, GraduationCap, Award, Calendar, MapPin, ExternalLink } from 'lucide-react'
import type { ExperienceItem, EducationItem, CertificateItem } from '@/data/portfolio'

interface Props {
  experiences: ExperienceItem[]
  education: EducationItem[]
  certificates: CertificateItem[]
}

const { experiences, education, certificates } = Astro.props

const totalCount = experiences.length + education.length + certificates.length
---

<section id="experience" class="py-12 md:py-14 px-4 max-w-4xl mx-auto border-t border-purple-500/10">
  <h2 class="reveal-init text-3xl font-bold text-white mb-6 text-center">Experience & Qualifications</h2>

  {/* Category Filter Tabs */}
  <div class="reveal-init flex items-center justify-center gap-2 mb-10 overflow-x-auto pb-1 scrollbar-none flex-wrap">
    <button
      type="button"
      data-timeline-filter="all"
      class="timeline-tab active px-4 py-2 rounded-xl text-xs sm:text-sm font-medium transition-all duration-200 cursor-pointer bg-purple-600 text-white border border-purple-400/40 shadow-md shadow-purple-900/40 whitespace-nowrap flex items-center gap-1.5"
    >
      <span>All</span>
      <span class="opacity-80 font-mono text-xs">({totalCount})</span>
    </button>

    <button
      type="button"
      data-timeline-filter="experience"
      class="timeline-tab px-4 py-2 rounded-xl text-xs sm:text-sm font-medium transition-all duration-200 cursor-pointer bg-white/[0.04] text-white/70 hover:text-white hover:bg-white/10 border border-white/10 whitespace-nowrap flex items-center gap-1.5"
    >
      <Briefcase className="w-3.5 h-3.5 text-purple-300" />
      <span>Work Experience</span>
      <span class="opacity-80 font-mono text-xs">({experiences.length})</span>
    </button>

    <button
      type="button"
      data-timeline-filter="education"
      class="timeline-tab px-4 py-2 rounded-xl text-xs sm:text-sm font-medium transition-all duration-200 cursor-pointer bg-white/[0.04] text-white/70 hover:text-white hover:bg-white/10 border border-white/10 whitespace-nowrap flex items-center gap-1.5"
    >
      <GraduationCap className="w-3.5 h-3.5 text-purple-300" />
      <span>Education</span>
      <span class="opacity-80 font-mono text-xs">({education.length})</span>
    </button>

    <button
      type="button"
      data-timeline-filter="certificates"
      class="timeline-tab px-4 py-2 rounded-xl text-xs sm:text-sm font-medium transition-all duration-200 cursor-pointer bg-white/[0.04] text-white/70 hover:text-white hover:bg-white/10 border border-white/10 whitespace-nowrap flex items-center gap-1.5"
    >
      <Award className="w-3.5 h-3.5 text-purple-300" />
      <span>Certificates</span>
      <span class="opacity-80 font-mono text-xs">({certificates.length})</span>
    </button>
  </div>

  <div class="flex flex-col gap-14">
    {/* ─── WORK EXPERIENCE SECTION ────────────────────────────────────────── */}
    <div data-timeline-category="experience" class="timeline-category-section flex flex-col gap-8">
      <div class="reveal-init flex items-center gap-3">
        <div class="w-10 h-10 rounded-xl bg-purple-900/40 border border-purple-500/30 flex items-center justify-center text-purple-300 shadow-md shadow-purple-950/40">
          <Briefcase className="w-5 h-5" />
        </div>
        <div>
          <h3 class="text-2xl font-bold text-white">Work Experience</h3>
          <p class="text-sm text-white/50">Pengalaman Kerja & Karir Professional</p>
        </div>
      </div>

      {/* Timeline Container */}
      <div class="relative pl-6 md:pl-8 border-l-2 border-purple-500/30 flex flex-col gap-10 ml-4 md:ml-5">
        {experiences.map((exp) => (
          <div class="reveal-init relative group">
            {/* Glowing Circle Node */}
            <div class="absolute -left-[31px] md:-left-[39px] top-1.5 w-4 h-4 rounded-full bg-purple-600 border-4 border-[#0d0010] shadow-[0_0_12px_rgba(168,85,247,0.9)] group-hover:scale-125 group-hover:bg-purple-400 transition-all duration-300"></div>

            {/* Content Card */}
            <div class="bg-[#0e0826]/85 border border-purple-500/20 hover:border-purple-500/50 rounded-2xl p-6 transition-all duration-300 hover:bg-[#130b33]/90 shadow-xl shadow-black/60">
              <div class="flex flex-col md:flex-row md:items-center justify-between gap-2 mb-3">
                <div>
                  <h4 class="text-xl font-bold text-white group-hover:text-purple-300 transition-colors">
                    {exp.role}
                  </h4>
                  <p class="text-purple-400 font-medium text-base">{exp.company}</p>
                </div>

                <div class="flex flex-wrap items-center gap-3 text-xs text-white/60">
                  <span class="flex items-center gap-1 bg-purple-950/60 border border-purple-500/20 px-3 py-1 rounded-full text-purple-300">
                    <Calendar className="w-3.5 h-3.5" />
                    {exp.period}
                  </span>
                  {exp.location && (
                    <span class="flex items-center gap-1">
                      <MapPin className="w-3.5 h-3.5 text-white/40" />
                      {exp.location}
                    </span>
                  )}
                </div>
              </div>

              <ul class="list-disc list-inside space-y-1.5 text-white/70 text-sm md:text-base leading-relaxed mb-4">
                {exp.description.map((item) => (
                  <li class="marker:text-purple-400">
                    {item}
                  </li>
                ))}
              </ul>

              {exp.skills && exp.skills.length > 0 && (
                <div class="flex flex-wrap gap-2 pt-2 border-t border-white/10">
                  {exp.skills.map((skill) => (
                    <span class="px-2.5 py-0.5 rounded-full text-xs bg-purple-950/40 border border-purple-500/30 text-purple-200">
                      {skill}
                    </span>
                  ))}
                </div>
              )}
            </div>
          </div>
        ))}
      </div>
    </div>

    {/* ─── EDUCATION SECTION ─────────────────────────────────────────────── */}
    <div data-timeline-category="education" class="timeline-category-section flex flex-col gap-8">
      <div class="reveal-init flex items-center gap-3">
        <div class="w-10 h-10 rounded-xl bg-purple-900/40 border border-purple-500/30 flex items-center justify-center text-purple-300 shadow-md shadow-purple-950/40">
          <GraduationCap className="w-5 h-5" />
        </div>
        <div>
          <h3 class="text-2xl font-bold text-white">Education</h3>
          <p class="text-sm text-white/50">Riwayat Pendidikan Akademik</p>
        </div>
      </div>

      {/* Timeline Container */}
      <div class="relative pl-6 md:pl-8 border-l-2 border-purple-500/30 flex flex-col gap-10 ml-4 md:ml-5">
        {education.map((edu) => (
          <div class="reveal-init relative group">
            {/* Glowing Circle Node */}
            <div class="absolute -left-[31px] md:-left-[39px] top-1.5 w-4 h-4 rounded-full bg-purple-600 border-4 border-[#0d0010] shadow-[0_0_12px_rgba(168,85,247,0.9)] group-hover:scale-125 group-hover:bg-purple-400 transition-all duration-300"></div>

            {/* Content Card */}
            <div class="bg-[#0e0826]/85 border border-purple-500/20 hover:border-purple-500/50 rounded-2xl p-6 transition-all duration-300 hover:bg-[#130b33]/90 shadow-xl shadow-black/60">
              <div class="flex flex-col md:flex-row md:items-center justify-between gap-2 mb-2">
                <div>
                  <h4 class="text-xl font-bold text-white group-hover:text-purple-300 transition-colors">
                    {edu.degree}
                  </h4>
                  <p class="text-purple-400 font-medium text-base">{edu.institution}</p>
                </div>

                <span class="flex items-center gap-1 self-start md:self-auto bg-purple-950/60 border border-purple-500/20 px-3 py-1 rounded-full text-xs text-purple-300">
                  <Calendar className="w-3.5 h-3.5" />
                  {edu.period}
                </span>
              </div>

              {edu.description && (
                <p class="text-white/70 text-sm md:text-base leading-relaxed mb-3">
                  {edu.description}
                </p>
              )}

              {edu.gpa && (
                <div class="inline-flex items-center gap-2 px-3 py-1 rounded-lg bg-white/5 border border-white/10 text-xs text-purple-200">
                  <span class="font-semibold text-purple-300">IPK / GPA:</span> {edu.gpa}
                </div>
              )}
            </div>
          </div>
        ))}
      </div>
    </div>

    {/* ─── CERTIFICATES SECTION ──────────────────────────────────────────── */}
    <div data-timeline-category="certificates" class="timeline-category-section flex flex-col gap-8">
      <div class="reveal-init flex items-center gap-3">
        <div class="w-10 h-10 rounded-xl bg-purple-900/40 border border-purple-500/30 flex items-center justify-center text-purple-300 shadow-md shadow-purple-950/40">
          <Award className="w-5 h-5" />
        </div>
        <div>
          <h3 class="text-2xl font-bold text-white">Certificates</h3>
          <p class="text-sm text-white/50">Sertifikasi & Lisensi Profesional</p>
        </div>
      </div>

      {/* Timeline Container */}
      <div class="relative pl-6 md:pl-8 border-l-2 border-purple-500/30 flex flex-col gap-10 ml-4 md:ml-5">
        {certificates.map((cert) => (
          <div class="reveal-init relative group">
            {/* Glowing Circle Node */}
            <div class="absolute -left-[31px] md:-left-[39px] top-1.5 w-4 h-4 rounded-full bg-purple-600 border-4 border-[#0d0010] shadow-[0_0_12px_rgba(168,85,247,0.9)] group-hover:scale-125 group-hover:bg-purple-400 transition-all duration-300"></div>

            {/* Content Card */}
            <div class="bg-[#0e0826]/85 border border-purple-500/20 hover:border-purple-500/50 rounded-2xl p-6 transition-all duration-300 hover:bg-[#130b33]/90 shadow-xl shadow-black/60">
              <div class="flex flex-col md:flex-row md:items-center justify-between gap-2 mb-3">
                <div>
                  <h4 class="text-lg font-bold text-white group-hover:text-purple-300 transition-colors">
                    {cert.title}
                  </h4>
                  <p class="text-purple-400 font-medium text-sm">{cert.issuer}</p>
                </div>

                <div class="flex items-center gap-3">
                  <span class="flex items-center gap-1 bg-purple-950/60 border border-purple-500/20 px-3 py-1 rounded-full text-xs text-purple-300">
                    <Calendar className="w-3.5 h-3.5" />
                    {cert.date}
                  </span>
                  {cert.credentialUrl && cert.credentialUrl !== '#' && (
                    <a
                      href={cert.credentialUrl}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="group flex items-center gap-1.5 px-3 py-1 rounded-full bg-white/10 border border-white/15 text-xs font-medium text-purple-300 hover:bg-white hover:text-black hover:border-white transition-all duration-300"
                    >
                      <span>Credential</span>
                      <ExternalLink className="w-3 h-3 text-purple-300 group-hover:text-black transition-colors duration-300" />
                    </a>
                  )}
                </div>
              </div>

              {cert.skills && cert.skills.length > 0 && (
                <div class="flex flex-wrap gap-2 pt-2 border-t border-white/10">
                  {cert.skills.map((skill) => (
                    <span class="px-2.5 py-0.5 rounded-full text-xs bg-purple-950/40 border border-purple-500/30 text-purple-200">
                      {skill}
                    </span>
                  ))}
                </div>
              )}
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<script is:inline>
  const setupTimelineTabs = () => {
    const tabs = document.querySelectorAll('.timeline-tab');
    const sections = document.querySelectorAll('.timeline-category-section');

    tabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        const filter = tab.getAttribute('data-timeline-filter');

        // Update tabs styling
        tabs.forEach((t) => {
          t.classList.remove('active', 'bg-purple-600', 'text-white', 'border-purple-400/40', 'shadow-md', 'shadow-purple-900/40');
          t.classList.add('bg-white/[0.04]', 'text-white/70', 'border-white/10');
        });

        tab.classList.add('active', 'bg-purple-600', 'text-white', 'border-purple-400/40', 'shadow-md', 'shadow-purple-900/40');
        tab.classList.remove('bg-white/[0.04]', 'text-white/70', 'border-white/10');

        // Filter sections with smooth visibility
        sections.forEach((sec) => {
          const category = sec.getAttribute('data-timeline-category');
          if (filter === 'all' || category === filter) {
            sec.classList.remove('hidden');
          } else {
            sec.classList.add('hidden');
          }
        });
      });
    });
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupTimelineTabs);
  } else {
    setupTimelineTabs();
  }
</script>
