---
import type { DockItem, SocialItem } from '@/data/portfolio'
import { ExternalLink } from 'lucide-react'

interface Props {
  navItems: DockItem[]
  socialItems: SocialItem[]
}

const { navItems, socialItems } = Astro.props
---

<!-- ─── DESKTOP / TABLET: Floating Left Rail Dock (Fixed on the Left) ─── -->
<nav
  aria-label="Sidebar Navigation Dock"
  class="fixed left-3 lg:left-6 xl:left-8 top-1/2 -translate-y-1/2 z-50 hidden md:flex flex-col p-3 rounded-2xl bg-[#0b0521]/90 backdrop-blur-xl border border-purple-500/25 shadow-2xl shadow-purple-950/70 w-[172px] xl:w-[188px] transition-all duration-300"
>
  {/* Navigation Links with Icon + Label Inside Pill Form */}
  <div class="flex flex-col gap-1.5">
    {navItems.map((item) => {
      const Icon = item.icon
      return (
        <a
          href={`#${item.id}`}
          data-nav-item={item.id}
          class="nav-link-item group relative flex items-center gap-3 px-3.5 py-2.5 rounded-xl text-sm font-medium text-white/75 hover:text-white hover:bg-white/[0.08] hover:border-white/10 border border-transparent transition-all duration-200 cursor-pointer"
        >
          <Icon className="nav-icon w-[18px] h-[18px] flex-shrink-0 text-white/60 group-hover:text-purple-300 transition-colors" />
          <span class="truncate tracking-tight">{item.label}</span>
        </a>
      )
    })}
  </div>

  {/* Divider */}
  <div class="h-px bg-white/[0.08] my-2.5 mx-1"></div>

  {/* Social Links Header */}
  <div class="px-2.5 py-0.5 mb-1 flex items-center justify-between">
    <span class="text-[10px] uppercase tracking-wider text-white/40 font-mono font-medium">Connect</span>
  </div>

  {/* Social Links */}
  <div class="flex flex-col gap-1">
    {socialItems.map((item) => {
      const Icon = item.icon
      return (
        <a
          href={item.href}
          target="_blank"
          rel="noopener noreferrer"
          class="group flex items-center gap-3 px-3.5 py-2 rounded-xl text-xs text-white/60 hover:text-white hover:bg-white/[0.06] transition-all duration-200"
          aria-label={item.label}
        >
          <Icon className="w-4 h-4 text-purple-300/70 group-hover:text-purple-300 flex-shrink-0 transition-colors" />
          <span class="truncate font-medium">{item.label}</span>
          <ExternalLink className="w-3 h-3 ml-auto opacity-35 group-hover:opacity-80 transition-opacity" />
        </a>
      )
    })}
  </div>
</nav>

<!-- ─── MOBILE: Floating Bottom Navigation Dock ─── -->
<nav
  aria-label="Mobile Navigation Dock"
  class="fixed bottom-5 left-1/2 -translate-x-1/2 z-50 flex md:hidden items-center gap-1 px-3 py-2 bg-[#0b0521]/90 backdrop-blur-xl border border-purple-500/25 rounded-2xl shadow-2xl shadow-black/80 max-w-[92vw]"
>
  {navItems.map((item) => {
    const Icon = item.icon
    return (
      <a
        href={`#${item.id}`}
        data-nav-item={item.id}
        class="nav-link-item group relative flex items-center justify-center w-10 h-10 rounded-xl text-white/70 hover:text-white hover:bg-white/10 border border-transparent transition-all duration-200"
        aria-label={item.label}
      >
        <Icon className="nav-icon w-4 h-4 text-white/70" />
      </a>
    )
  })}

  <div class="w-px h-5 bg-white/10 mx-1"></div>

  {socialItems.map((item) => {
    const Icon = item.icon
    return (
      <a
        href={item.href}
        target="_blank"
        rel="noopener noreferrer"
        class="flex items-center justify-center w-9 h-9 rounded-xl text-white/60 hover:text-white hover:bg-white/10 transition-all duration-200"
        aria-label={item.label}
      >
        <Icon className="w-4 h-4 text-purple-300/70" />
      </a>
    )
  })}
</nav>

<style is:global>
  .nav-link-item.is-active {
    background: linear-gradient(135deg, rgba(147, 51, 234, 0.95), rgba(99, 102, 241, 0.95)) !important;
    color: #ffffff !important;
    font-weight: 600 !important;
    border-color: rgba(192, 132, 252, 0.5) !important;
    box-shadow: 0 0 16px rgba(168, 85, 247, 0.45) !important;
  }

  .nav-link-item.is-active .nav-icon {
    color: #ffffff !important;
  }
</style>

<script is:inline>
  const setupDockScrollspy = () => {
    const sectionIds = ['hero', 'about', 'experience', 'projects', 'contact'];
    const sections = sectionIds
      .map((id) => document.getElementById(id))
      .filter((el) => el !== null);

    const navLinks = document.querySelectorAll('[data-nav-item]');

    const setActiveSection = (activeId) => {
      navLinks.forEach((link) => {
        const target = link.getAttribute('data-nav-item');
        if (target === activeId) {
          link.classList.add('is-active');
        } else {
          link.classList.remove('is-active');
        }
      });
    };

    const handleScroll = () => {
      const scrollY = window.scrollY;
      const windowHeight = window.innerHeight;
      const docHeight = document.documentElement.scrollHeight;

      // When near the bottom of the page, activate the last section (Contact)
      if (scrollY + windowHeight >= docHeight - 70) {
        setActiveSection(sectionIds[sectionIds.length - 1]);
        return;
      }

      // Check which section is in the upper middle area of viewport
      const triggerPosition = scrollY + windowHeight * 0.35;
      let activeSectionId = sectionIds[0];

      for (let i = 0; i < sections.length; i++) {
        const section = sections[i];
        const top = section.offsetTop;
        const height = section.offsetHeight;

        if (triggerPosition >= top && triggerPosition < top + height) {
          activeSectionId = section.id;
          break;
        }
      }

      setActiveSection(activeSectionId);
    };

    window.addEventListener('scroll', handleScroll, { passive: true });
    // Initial check
    handleScroll();
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupDockScrollspy);
  } else {
    setupDockScrollspy();
  }
</script>
