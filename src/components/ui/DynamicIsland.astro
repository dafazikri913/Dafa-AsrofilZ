---
import type { DockItem, SocialItem } from '@/data/portfolio'

interface Props {
  navItems: DockItem[]
  socialItems: SocialItem[]
}

const { navItems, socialItems } = Astro.props
---

<nav
  aria-label="Floating Navigation Dock"
  class="fixed bottom-6 left-1/2 -translate-x-1/2 z-50 transform-gpu contain-paint flex items-center gap-1 px-3 py-2 bg-[#0a051d]/90 backdrop-blur-md border border-white/15 rounded-2xl shadow-xl shadow-black/70 transition-all"
>
  {/* Navigation Items */}
  {navItems.map((item) => {
    const Icon = item.icon
    return (
      <a
        href={`#${item.id}`}
        class="group relative flex items-center justify-center w-10 h-10 rounded-xl hover:bg-white/10 transition-all duration-200 hover:scale-125 focus:scale-125 focus:outline-none"
        aria-label={item.label}
      >
        {/* Tooltip */}
        <span class="pointer-events-none absolute -top-9 left-1/2 -translate-x-1/2 whitespace-nowrap rounded-md bg-[#130b30]/95 backdrop-blur-sm border border-white/20 px-2 py-0.5 text-xs font-medium text-white/95 opacity-0 scale-90 translate-y-1 group-hover:opacity-100 group-hover:scale-100 group-hover:translate-y-0 transition-all duration-150 shadow-md">
          {item.label}
        </span>
        <Icon className="w-5 h-5 text-white/70 group-hover:text-white transition-colors" />
      </a>
    )
  })}

  {/* Divider */}
  <div class="w-px h-6 bg-white/10 mx-1"></div>

  {/* Social Items */}
  {socialItems.map((item) => {
    const Icon = item.icon
    return (
      <a
        href={item.href}
        target="_blank"
        rel="noopener noreferrer"
        class="group relative flex items-center justify-center w-10 h-10 rounded-xl hover:bg-white/10 transition-all duration-200 hover:scale-125 focus:scale-125 focus:outline-none"
        aria-label={item.label}
      >
        {/* Tooltip */}
        <span class="pointer-events-none absolute -top-9 left-1/2 -translate-x-1/2 whitespace-nowrap rounded-md bg-[#130b30]/95 backdrop-blur-sm border border-white/20 px-2 py-0.5 text-xs font-medium text-white/95 opacity-0 scale-90 translate-y-1 group-hover:opacity-100 group-hover:scale-100 group-hover:translate-y-0 transition-all duration-150 shadow-md">
          {item.label}
        </span>
        <Icon className="w-5 h-5 text-white/70 group-hover:text-white transition-colors" />
      </a>
    )
  })}
</nav>
