---
// Compact Tech Icons Grid ("Kotak Kecil" with Icon above Tech Name)

export interface TechItem {
  name: string
  color: string
}

const TECHNOLOGIES = [
  { id: 'react', name: 'React', color: '#61DAFB' },
  { id: 'nextjs', name: 'Next.js', color: '#FFFFFF' },
  { id: 'astro', name: 'Astro', color: '#FF5D01' },
  { id: 'typescript', name: 'TypeScript', color: '#3178C6' },
  { id: 'tailwind', name: 'Tailwind CSS', color: '#38BDF8' },
  { id: 'magicui', name: 'Magic UI', color: '#EC4899' },
  { id: 'nodejs', name: 'Node.js', color: '#5FA04E' },
  { id: 'express', name: 'Express', color: '#FFFFFF' },
  { id: 'go', name: 'Go', color: '#00ADD8' },
  { id: 'postgresql', name: 'PostgreSQL', color: '#336791' },
  { id: 'prisma', name: 'Prisma', color: '#5A67D8' },
  { id: 'docker', name: 'Docker', color: '#2496ED' },
  { id: 'playwright', name: 'Playwright', color: '#2EAD33' },
  { id: 'n8n', name: 'n8n', color: '#EA4B71' },
  { id: 'framer', name: 'Framer Motion', color: '#F08' },
  { id: 'vite', name: 'Vite', color: '#BD34FE' },
  { id: 'git', name: 'Git', color: '#F05032' },
  { id: 'figma', name: 'Figma', color: '#F24E1E' },
]
---

<div class="grid grid-cols-3 sm:grid-cols-4 md:grid-cols-6 gap-3">
  {TECHNOLOGIES.map((tech) => (
    <div
      class="group relative flex flex-col items-center justify-center p-3 sm:p-3.5 rounded-xl bg-white/[0.04] border border-white/10 hover:border-purple-500/50 hover:bg-[#120a2e]/90 hover:-translate-y-1 hover:shadow-lg hover:shadow-purple-950/50 transition-all duration-300 cursor-default"
      title={tech.name}
    >
      {/* Icon Area */}
      <div class="w-8 h-8 sm:w-9 sm:h-9 flex items-center justify-center mb-2 group-hover:scale-110 transition-transform duration-300">
        {tech.id === 'react' && (
          <svg viewBox="-11.5 -10.23 23 20.46" class="w-7 h-7" fill="none">
            <circle cx="0" cy="0" r="2.05" fill="#61DAFB"/>
            <g stroke="#61DAFB" stroke-width="1">
              <ellipse rx="11" ry="4.2"/>
              <ellipse rx="11" ry="4.2" transform="rotate(60)"/>
              <ellipse rx="11" ry="4.2" transform="rotate(120)"/>
            </g>
          </svg>
        )}

        {tech.id === 'nextjs' && (
          <svg viewBox="0 0 24 24" class="w-7 h-7" fill="none">
            <circle cx="12" cy="12" r="11" fill="#000" stroke="#FFF" stroke-width="1.2"/>
            <path fill="#FFF" d="M15.5 8.5v7h-1.5V11.2l-5.3 7.1C7.8 17.6 7 16.1 6.5 14.5l6-8h3z"/>
            <rect x="15.5" y="8.5" width="1.5" height="7" fill="#FFF"/>
          </svg>
        )}

        {tech.id === 'astro' && (
          <svg viewBox="0 0 24 24" class="w-7 h-7" fill="none">
            <path fill="#BC52EE" d="M7.74 18.25c.34-.33.82-.48 1.28-.39.84.17 1.94.3 2.98.3 1.04 0 2.14-.13 2.98-.3.46-.09.94.06 1.28.39l2.76 2.7c.36.35.43.91.16 1.34-.36.56-1.12.71-1.68.33l-2.43-1.63c-.94.19-2.02.31-3.07.31-1.05 0-2.13-.12-3.07-.31l-2.43 1.63c-.56.38-1.32.23-1.68-.33-.27-.43-.2-.99.16-1.34l2.74-2.7z"/>
            <path fill="#FFF" d="M12 2C8 6 6 10 6 15c0 1.5.5 3 1.5 4.2l1.6-1.6C8.4 16.6 8 15.3 8 14c0-3.5 1.8-7 4-10.5 2.2 3.5 4 7 4 10.5 0 1.3-.4 2.6-1.1 3.6l1.6 1.6c1-1.2 1.5-2.7 1.5-4.2 0-5-2-9-6-13z"/>
            <ellipse cx="12" cy="14" rx="1.8" ry="2.2" fill="#FF5D01"/>
          </svg>
        )}

        {tech.id === 'typescript' && (
          <svg viewBox="0 0 24 24" class="w-7 h-7">
            <rect width="24" height="24" rx="4" fill="#3178C6"/>
            <path fill="#FFF" d="M3.75 8.75h7.5v2.25H8.625v7.5H6.375v-7.5H3.75V8.75zm8.5 7.75c.625.5 1.5.875 2.5.875 1.25 0 2-.625 2-1.5 0-.875-.625-1.25-1.75-1.75-1.5-.625-2.5-1.375-2.5-2.75 0-1.625 1.25-2.75 3.125-2.75 1.125 0 2 .375 2.625.75l-.625 2c-.5-.375-1.25-.625-2-.625-1 0-1.625.5-1.625 1.25 0 .75.5 1.125 1.625 1.625 1.625.625 2.625 1.375 2.625 2.875 0 1.75-1.375 2.875-3.375 2.875-1.375 0-2.375-.5-3.125-1l.5-2z"/>
          </svg>
        )}

        {tech.id === 'tailwind' && (
          <svg viewBox="0 0 24 24" class="w-7 h-7" fill="#38BDF8">
            <path d="M12.001 4.8c-3.2 0-5.2 1.6-6 4.8 1.2-1.6 2.6-2.2 4.2-1.8.913.228 1.565.89 2.288 1.624C13.666 10.618 15.027 12 18.001 12c3.2 0 5.2-1.6 6-4.8-1.2 1.6-2.6 2.2-4.2 1.8-.913-.228-1.565-.89-2.288-1.624C16.336 6.182 14.975 4.8 12.001 4.8zm-6 7.2c-3.2 0-5.2 1.6-6 4.8 1.2-1.6 2.6-2.2 4.2-1.8.913.228 1.565.89 2.288 1.624 1.177 1.194 2.538 2.576 5.512 2.576 3.2 0 5.2-1.6 6-4.8-1.2 1.6-2.6 2.2-4.2 1.8-.913-.228-1.565-.89-2.288-1.624C10.336 13.382 8.975 12 6.001 12z"/>
          </svg>
        )}

        {tech.id === 'magicui' && (
          <svg viewBox="0 0 24 24" class="w-7 h-7" fill="none">
            <path d="M14.5 4.5l5 5-11 11-5-5 11-11z" stroke="url(#magic-ui-grad)" stroke-width="1.8" stroke-linejoin="round"/>
            <path d="M12 7l5 5M4.5 14.5l5 5" stroke="url(#magic-ui-grad)" stroke-width="1.2"/>
            <path d="M18.5 2l.6 1.4 1.4.6-1.4.6-.6 1.4-.6-1.4-1.4-.6 1.4-.6.6-1.4zM4.5 2l.5 1 1 .5-1 .5-.5 1-.5-1-1-.5 1-.5.5-1zM20 16l.5 1.1 1.1.5-1.1.5-.5 1.1-.5-1.1-1.1-.5 1.1-.5.5-1.1z" fill="#EC4899"/>
            <defs>
              <linearGradient id="magic-ui-grad" x1="3" y1="21" x2="21" y2="3" gradientUnits="userSpaceOnUse">
                <stop stop-color="#A855F7"/>
                <stop offset="0.5" stop-color="#EC4899"/>
                <stop offset="1" stop-color="#3B82F6"/>
              </linearGradient>
            </defs>
          </svg>
        )}

        {tech.id === 'nodejs' && (
          <svg viewBox="0 0 24 24" class="w-7 h-7" fill="#5FA04E">
            <path d="M12 2l9 5.2v10.4L12 22.8 3 17.6V7.2L12 2zm0 2.3L4.9 8.4v7.2L12 19.7l7.1-4.1V8.4L12 4.3z"/>
            <path d="M12 7.5l4.8 2.8v5.5L12 18.5l-4.8-2.7v-5.5L12 7.5z"/>
          </svg>
        )}

        {tech.id === 'express' && (
          <svg viewBox="0 0 24 24" class="w-7 h-7" fill="#FFF">
            <path d="M24 18.579h-4.375l-4.58-6.191-4.579 6.191H6.091l6.818-9.014L6.467 1.421h4.375l4.303 5.867 4.304-5.867h4.375l-6.545 8.711L24 18.579zM3.447 18.579H0V1.421h3.447v17.158z"/>
          </svg>
        )}

        {tech.id === 'go' && (
          <svg viewBox="0 0 24 24" class="w-7 h-7" fill="none">
            <rect width="24" height="24" rx="4" fill="#00ADD8"/>
            <path fill="#FFF" d="M4 12c0-2.5 1.8-4.5 4.5-4.5 1.8 0 3 .8 3.7 1.8l-1.6 1.3c-.5-.7-1.2-1.2-2.1-1.2-1.4 0-2.4 1.1-2.4 2.6s1 2.6 2.4 2.6c.9 0 1.6-.4 2.1-1.1v-.8H8.5v-1.8h4.2v3.6C11.8 15.6 10.4 16.5 8.5 16.5 5.8 16.5 4 14.5 4 12zm11.5 4.5c-2.5 0-4.3-1.9-4.3-4.5s1.8-4.5 4.3-4.5 4.3 1.9 4.3 4.5-1.8 4.5-4.3 4.5zm0-2c1.3 0 2.2-1.1 2.2-2.5s-.9-2.5-2.2-2.5-2.2 1.1-2.2 2.5.9 2.5 2.2 2.5z"/>
          </svg>
        )}

        {tech.id === 'postgresql' && (
          <svg viewBox="0 0 24 24" class="w-7 h-7" fill="#336791">
            <path d="M18.84 8.78c-.28-1.78-1.57-3.04-3.32-3.23-1.54-.17-3.06.66-3.79 2.05-.28-.21-.59-.39-.92-.53-.8-.34-1.69-.37-2.52-.07-1.63.59-2.71 2.1-2.67 3.84.03 1.25.64 2.39 1.64 3.1l-.14 1.83c-.07.97.66 1.81 1.63 1.88.97.07 1.81-.66 1.88-1.63l.11-1.46c.39.11.8.17 1.21.17.67 0 1.33-.16 1.93-.46l1.24 1.24c.64.64 1.67.64 2.31 0 .64-.64.64-1.67 0-2.31l-.81-.81c1.23-1.07 1.83-2.73 1.23-4.67zm-3.84 5.34l-1.06-1.06c-.46.33-1.01.52-1.59.52-.45 0-.88-.12-1.26-.33l-.38 4.96c-.03.43-.39.75-.82.72-.43-.03-.75-.39-.72-.82l.33-4.32c-.93-.65-1.45-1.72-1.41-2.85.06-1.85 1.54-3.3 3.39-3.26.79.02 1.53.33 2.09.87.64-.87 1.73-1.34 2.82-1.18 1.41.21 2.45 1.39 2.53 2.81.1 1.8-1.06 3.42-2.92 3.94z"/>
          </svg>
        )}

        {tech.id === 'prisma' && (
          <svg viewBox="0 0 24 24" class="w-7 h-7" fill="none">
            <path fill="#5A67D8" d="M12.63 2.16a1 1 0 00-1.26 0L2.1 9.42a1 1 0 00-.36.95l2.4 10.45a1 1 0 00.9.78l13.84.4a1 1 0 00.9-.59l3.08-7.9a1 1 0 00-.14-.97L12.63 2.16zM4.04 10.15l7.96-6.19 7.96 6.19-2.22 5.7H6.26l-2.22-5.7z"/>
          </svg>
        )}

        {tech.id === 'docker' && (
          <svg viewBox="0 0 24 24" class="w-7 h-7" fill="#2496ED">
            <path d="M13.983 11.078h2.119a.186.186 0 00.186-.185V9.006a.186.186 0 00-.186-.186h-2.119a.185.185 0 00-.185.185v1.888c0 .102.083.185.185.185m-2.954-5.43h2.118a.186.186 0 00.186-.186V3.574a.186.186 0 00-.186-.185h-2.118a.185.185 0 00-.185.185v1.888c0 .102.082.185.185.185zm0 2.716h2.118a.187.187 0 00.186-.186V6.29a.186.186 0 00-.186-.185h-2.118a.185.185 0 00-.185.185v1.887c0 .102.082.186.185.186zm-2.93 0h2.12a.186.186 0 00.184-.186V6.29a.185.185 0 00-.185-.185H8.1a.185.185 0 00-.185.185v1.887c0 .102.083.186.185.186zm-2.964 0h2.119a.186.186 0 00.185-.186V6.29a.185.185 0 00-.185-.185H5.136a.186.186 0 00-.186.185v1.887c0 .102.084.186.186.186zm5.893 2.715h2.118a.186.186 0 00.186-.186V9.006a.186.186 0 00-.186-.186h-2.118a.185.185 0 00-.185.185v1.888c0 .102.082.185.185.185zm-2.93 0h2.12a.185.185 0 00.184-.185V9.006a.185.185 0 00-.184-.186h-2.12a.185.185 0 00-.184.185v1.888c0 .102.083.185.185.185zm-2.964 0h2.119a.185.185 0 00.185-.185V9.006a.185.185 0 00-.185-.186H5.136a.186.186 0 00-.186.185v1.888c0 .102.084.185.186.185zm-2.928 0h2.119a.185.185 0 00.185-.185V9.006a.185.185 0 00-.185-.186H2.208a.186.186 0 00-.186.185v1.888c0 .102.084.185.186.185zM23.978 12.5a6.452 6.452 0 00-4.04-4.524l-.39-.144-.242.338c-.732 1.026-1.802 1.688-3.056 1.888l-.403.064v.933a.186.186 0 00.186.185h6.398c.573 0 1.107.417 1.196.985.127.81-.39 1.547-1.18 1.637H.34c-.218 0-.34.186-.34.372 0 3.754 2.87 6.792 6.516 6.792 4.673 0 8.448-3.045 10.42-6.526h4.55c1.42 0 2.492-1.077 2.492-2.001"/>
          </svg>
        )}

        {tech.id === 'playwright' && (
          <svg viewBox="0 0 24 24" class="w-7 h-7">
            <path fill="#2EAD33" d="M16.5 3a5.5 5.5 0 00-5.46 4.8 5.5 5.5 0 00-5.54 5.2A5.5 5.5 0 0011 18.5a5.5 5.5 0 005.5-5.5A5.5 5.5 0 0022 7.5 5.5 5.5 0 0016.5 3zm-6.5 12a2.5 2.5 0 110-5 2.5 2.5 0 010 5zm6.5-6a2.5 2.5 0 110-5 2.5 2.5 0 010 5z"/>
            <path fill="#E05D44" d="M8.5 7A4.5 4.5 0 004 11.5 4.5 4.5 0 008.5 16a4.5 4.5 0 004.5-4.5A4.5 4.5 0 008.5 7zm0 6a1.5 1.5 0 110-3 1.5 1.5 0 010 3z"/>
          </svg>
        )}

        {tech.id === 'n8n' && (
          <svg viewBox="0 0 24 24" class="w-7 h-7" fill="none">
            <circle cx="5" cy="12" r="3" fill="#EA4B71"/>
            <circle cx="19" cy="6" r="3" fill="#FF6D5A"/>
            <circle cx="19" cy="18" r="3" fill="#EA4B71"/>
            <path stroke="#EA4B71" stroke-width="2" stroke-linecap="round" d="M7.8 10.8L16.2 7.2M7.8 13.2L16.2 16.8"/>
          </svg>
        )}

        {tech.id === 'framer' && (
          <svg viewBox="0 0 24 24" class="w-7 h-7" fill="none">
            <path d="M4 2h16v7h-8zM4 9h8l8 7H4zM4 16h8v7z" fill="url(#framer-grad)"/>
            <defs>
              <linearGradient id="framer-grad" x1="4" y1="2" x2="20" y2="23" gradientUnits="userSpaceOnUse">
                <stop stop-color="#0055FF"/>
                <stop offset="1" stop-color="#FF0088"/>
              </linearGradient>
            </defs>
          </svg>
        )}

        {tech.id === 'vite' && (
          <svg viewBox="0 0 24 24" class="w-7 h-7" fill="none">
            <path d="M20.8 4.2L12.5 19.4a.7.7 0 01-1.2 0L3.2 4.2a.7.7 0 01.7-.9l16.2.2a.7.7 0 01.7.7z" fill="url(#vite-v)"/>
            <path d="M14.6 3.5l-6.8 7.4 3.7.3-3.2 6.5 8-8.2-3.8-.3 2.1-5.7z" fill="url(#vite-bolt)"/>
            <defs>
              <linearGradient id="vite-v" x1="3" y1="3" x2="21" y2="20" gradientUnits="userSpaceOnUse">
                <stop stop-color="#41D1FF"/>
                <stop offset="1" stop-color="#BD34FE"/>
              </linearGradient>
              <linearGradient id="vite-bolt" x1="8" y1="3" x2="16" y2="18" gradientUnits="userSpaceOnUse">
                <stop stop-color="#FFEA83"/>
                <stop offset="1" stop-color="#FFDD35"/>
              </linearGradient>
            </defs>
          </svg>
        )}

        {tech.id === 'git' && (
          <svg viewBox="0 0 24 24" class="w-7 h-7" fill="#F05032">
            <path d="M21.707 11.293l-9-9a.999.999 0 00-1.414 0l-9 9a.999.999 0 000 1.414l9 9a.999.999 0 001.414 0l9-9a.999.999 0 000-1.414zM12 19.586l-7.586-7.586L12 4.414l7.586 7.586L12 19.586zM13 10.414V8.586a1.5 1.5 0 10-2 0v1.828a2.5 2.5 0 00-1 1.95v2.857a1.5 1.5 0 102 0v-2.857c.367-.367.633-.82.78-1.321.492.348 1.12.551 1.72.391a1.5 1.5 0 10-.5-2.02z"/>
          </svg>
        )}

        {tech.id === 'figma' && (
          <svg viewBox="0 0 24 24" class="w-7 h-7" fill="none">
            <path d="M8 2h4v5H8a2.5 2.5 0 010-5z" fill="#F24E1E"/>
            <path d="M12 2h4a2.5 2.5 0 010 5h-4V2z" fill="#FF7262"/>
            <path d="M8 7h4v5H8a2.5 2.5 0 010-5z" fill="#A259FF"/>
            <path d="M12 7h4a2.5 2.5 0 010 5h-4V7z" fill="#1ABCFE"/>
            <path d="M8 12h4v5H8a2.5 2.5 0 010-5z" fill="#0ACF83"/>
            <circle cx="12" cy="14.5" r="2.5" fill="#1ABCFE"/>
          </svg>
        )}
      </div>

      {/* Label under icon */}
      <span class="text-[11px] sm:text-xs font-medium text-white/80 group-hover:text-white transition-colors text-center truncate max-w-full tracking-tight">
        {tech.name}
      </span>
    </div>
  ))}
</div>
