---
// Compact Tech Icons Grid with Category Differentiators (Frontend, Backend, Lainnya)

export interface TechItem {
  id: string
  name: string
  color: string
}

export interface TechCategory {
  id: string
  name: string
  shortLabel: string
  dotColor: string
  items: TechItem[]
}

export const CATEGORIES: TechCategory[] = [
  {
    id: 'frontend',
    name: 'Frontend Development',
    shortLabel: 'Frontend',
    dotColor: 'bg-cyan-400 shadow-[0_0_8px_rgba(34,211,238,0.7)]',
    items: [
      { id: 'react', name: 'React', color: '#61DAFB' },
      { id: 'typescript', name: 'TypeScript', color: '#3178C6' },
      { id: 'tailwind', name: 'Tailwind CSS', color: '#38BDF8' },
      { id: 'magicui', name: 'Magic UI', color: '#EC4899' },
      { id: 'framer', name: 'Framer Motion', color: '#F08' },
    ],
  },
  {
    id: 'fullstack',
    name: 'Fullstack Frameworks',
    shortLabel: 'Fullstack',
    dotColor: 'bg-rose-400 shadow-[0_0_8px_rgba(251,113,133,0.7)]',
    items: [
      { id: 'nextjs', name: 'Next.js', color: '#FFFFFF' },
      { id: 'astro', name: 'Astro', color: '#FF5D01' },
      { id: 'tanstackstart', name: 'TanStack Start', color: '#06B6D4' },
      { id: 'tanstack', name: 'TanStack', color: '#F43F5E' },
    ],
  },
  {
    id: 'backend',
    name: 'Backend & Database',
    shortLabel: 'Backend',
    dotColor: 'bg-emerald-400 shadow-[0_0_8px_rgba(52,211,153,0.7)]',
    items: [
      { id: 'nodejs', name: 'Node.js', color: '#5FA04E' },
      { id: 'express', name: 'Express', color: '#FFFFFF' },
      { id: 'go', name: 'Go', color: '#00ADD8' },
      { id: 'postgresql', name: 'PostgreSQL', color: '#336791' },
      { id: 'prisma', name: 'Prisma', color: '#5A67D8' },
    ],
  },
  {
    id: 'tools',
    name: 'Tools & DevOps',
    shortLabel: 'Tools',
    dotColor: 'bg-purple-400 shadow-[0_0_8px_rgba(192,132,252,0.7)]',
    items: [
      { id: 'docker', name: 'Docker', color: '#2496ED' },
      { id: 'git', name: 'Git', color: '#F05032' },
      { id: 'vite', name: 'Vite', color: '#BD34FE' },
      { id: 'playwright', name: 'Playwright', color: '#2EAD33' },
      { id: 'n8n', name: 'n8n', color: '#EA4B71' },
      { id: 'figma', name: 'Figma', color: '#F24E1E' },
    ],
  },
  {
    id: 'os',
    name: 'Operating System',
    shortLabel: 'OS',
    dotColor: 'bg-amber-400 shadow-[0_0_8px_rgba(251,191,36,0.7)]',
    items: [
      { id: 'windows', name: 'Windows', color: '#0078D4' },
      { id: 'ubuntu', name: 'Ubuntu', color: '#E95420' },
      { id: 'kalilinux', name: 'Kali Linux', color: '#557C94' },
    ],
  },
]

export const totalStacks = CATEGORIES.reduce((acc, cat) => acc + cat.items.length, 0)
---

<div class="w-full flex flex-col">
  {/* Category Filter Tabs */}
  <div class="flex items-center gap-2 mb-6 overflow-x-auto pb-1 scrollbar-none">
    <button
      type="button"
      data-filter="all"
      class="tech-tab active px-3.5 py-1.5 rounded-lg text-xs font-medium transition-all duration-200 cursor-pointer bg-purple-600 text-white border border-purple-400/40 shadow-md shadow-purple-900/40 whitespace-nowrap"
    >
      Semua <span class="opacity-75 font-mono ml-1">{totalStacks}</span>
    </button>
    {CATEGORIES.map((cat) => (
      <button
        type="button"
        data-filter={cat.id}
        class="tech-tab px-3.5 py-1.5 rounded-lg text-xs font-medium transition-all duration-200 cursor-pointer bg-white/[0.04] text-white/70 hover:text-white hover:bg-white/10 border border-white/10 whitespace-nowrap"
      >
        {cat.shortLabel} <span class="opacity-75 font-mono ml-1">{cat.items.length}</span>
      </button>
    ))}
  </div>

  {/* Categorized Sections */}
  <div class="flex flex-col gap-6">
    {CATEGORIES.map((category) => (
      <div data-category={category.id} class="tech-category-section flex flex-col">
        {/* Category Header */}
        <div class="flex items-center gap-2.5 mb-3">
          <span class={`w-2 h-2 rounded-full ${category.dotColor}`}></span>
          <h4 class="text-xs font-semibold uppercase tracking-wider text-white/90">
            {category.name}
          </h4>
          <span class="text-[11px] text-white/40 font-mono">
            ({category.items.length})
          </span>
          <div class="flex-1 h-[1px] bg-white/10"></div>
        </div>

        {/* Tech Grid */}
        <div class="grid grid-cols-3 sm:grid-cols-4 md:grid-cols-6 gap-3">
          {category.items.map((tech) => (
            <div
              class="group relative flex flex-col items-center justify-center p-3 sm:p-3.5 rounded-xl bg-white/[0.04] border border-white/10 hover:border-purple-500/60 hover:bg-[#120a2e]/90 hover:shadow-[0_0_20px_rgba(168,85,247,0.35)] transition-all duration-300 cursor-default"
              title={tech.name}
            >
              {/* Icon Area */}
              <div class="w-8 h-8 sm:w-9 sm:h-9 flex items-center justify-center mb-2 transition-colors duration-300">
                {tech.id === 'react' && (
                  <svg viewBox="-11.5 -10.23 23 20.46" class="w-7 h-7" fill="none">
                    <circle cx="0" cy="0" r="2.05" fill="#61DAFB"/>
                    <g stroke="#61DAFB" stroke-width="1">
                      <ellipse rx="11" ry="4.2"/>
                      <ellipse rx="11" ry="4.2" transform="rotate(60)"/>
                      <ellipse rx="11" ry="4.2" transform="rotate(120)"/>
                    </g>
                  </svg>
                )}

                {tech.id === 'nextjs' && (
                  <svg viewBox="0 0 24 24" class="w-7 h-7" fill="none">
                    <circle cx="12" cy="12" r="11" fill="#000" stroke="#FFF" stroke-width="1.2"/>
                    <path fill="#FFF" d="M15.5 8.5v7h-1.5V11.2l-5.3 7.1C7.8 17.6 7 16.1 6.5 14.5l6-8h3z"/>
                    <rect x="15.5" y="8.5" width="1.5" height="7" fill="#FFF"/>
                  </svg>
                )}

                {tech.id === 'astro' && (
                  <svg viewBox="0 0 24 24" class="w-7 h-7" fill="none">
                    <path fill="#BC52EE" d="M7.74 18.25c.34-.33.82-.48 1.28-.39.84.17 1.94.3 2.98.3 1.04 0 2.14-.13 2.98-.3.46-.09.94.06 1.28.39l2.76 2.7c.36.35.43.91.16 1.34-.36.56-1.12.71-1.68.33l-2.43-1.63c-.94.19-2.02.31-3.07.31-1.05 0-2.13-.12-3.07-.31l-2.43 1.63c-.56.38-1.32.23-1.68-.33-.27-.43-.2-.99.16-1.34l2.74-2.7z"/>
                    <path fill="#FFF" d="M12 2C8 6 6 10 6 15c0 1.5.5 3 1.5 4.2l1.6-1.6C8.4 16.6 8 15.3 8 14c0-3.5 1.8-7 4-10.5 2.2 3.5 4 7 4 10.5 0 1.3-.4 2.6-1.1 3.6l1.6 1.6c1-1.2 1.5-2.7 1.5-4.2 0-5-2-9-6-13z"/>
                    <ellipse cx="12" cy="14" rx="1.8" ry="2.2" fill="#FF5D01"/>
                  </svg>
                )}

                {tech.id === 'tanstack' && (
                  <svg viewBox="0 0 38.06 50" class="w-7 h-7" fill="none">
                    <path fill="url(#tanstack-grad)" fill-rule="evenodd" d="M19.03,0c13.76,0,19.03,8.54,19.03,25s-5.27,25-19.03,25S0,41.46,0,25C0,8.54,5.27,0,19.03,0ZM25.32,36.42c-1.79,0-2.76.49-3.55.88-.68.34-1.21.61-2.38.61-1.17,0-1.71-.27-2.38-.61-.78-.39-1.76-.88-3.55-.88-1.79,0-2.76.49-3.55.88-.68.34-1.21.61-2.38.61v2.6c1.79,0,2.76-.49,3.55-.88.68-.34,1.21-.61,2.38-.61s1.71.27,2.38.61c.78.39,1.76.88,3.55.88s2.76-.49,3.55-.88c.68-.34,1.21-.61,2.38-.61s1.71.27,2.38.61c.78.39,1.76.88,3.55.88v-2.6c-1.17,0-1.71-.27-2.38-.61-.78-.39-1.76-.88-3.55-.88ZM26.17,10.31c1.35-1.22,0-3.43-1.69-2.76-.93.37-1.81.91-2.59,1.62-1.23,1.11-2.05,2.52-2.5,4.04-.44-1.53-1.27-2.93-2.5-4.04-.78-.7-1.66-1.25-2.6-1.62-1.69-.67-3.04,1.54-1.69,2.76l4.95,4.49c-1.62-1.1-3.56-1.75-5.67-1.75-1.15,0-2.25.19-3.28.54-1.73.59-1.25,3.19.57,3.19h6.91c-1.52.29-2.97.97-4.18,2.06-.78.7-1.4,1.53-1.87,2.43-.84,1.61,1.22,3.18,2.57,1.97l5.57-5.04-.42,13.87c0,.17-.1.33-.22.46-.18-.08-.35-.16-.53-.26-.78-.39-1.76-.88-3.55-.88s-2.76.49-3.55.88c-.68.34-1.21.61-2.38.61v2.6c1.79,0,2.76-.49,3.55-.88.68-.34,1.21-.61,2.38-.61s1.71.27,2.38.61c.78.39,1.76.88,3.55.88s2.76-.49,3.55-.88c.68-.34,1.21-.61,2.38-.61s1.71.27,2.38.61c.78.39,1.76.88,3.55.88v-2.6c-1.17,0-1.71-.27-2.38-.61h0c-.78-.4-1.76-.89-3.55-.89s-2.76.49-3.55.88c-.2.1-.39.2-.59.28-.15-.13-.24-.3-.25-.48l-.42-13.94,5.65,5.12c1.35,1.22,3.4-.35,2.57-1.97-.46-.89-1.08-1.72-1.87-2.43-1.21-1.1-2.65-1.77-4.18-2.06h6.91c1.83,0,2.3-2.6.57-3.19-1.03-.35-2.13-.54-3.28-.54-2.1,0-4.04.65-5.67,1.75l4.95-4.49Z"/>
                    <defs>
                      <linearGradient id="tanstack-grad" x1="0" y1="50" x2="38" y2="0" gradientUnits="userSpaceOnUse">
                        <stop stop-color="#EA580C"/>
                        <stop offset="0.5" stop-color="#F43F5E"/>
